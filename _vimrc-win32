" set colorscheme
color catppuccin_mocha
set termguicolors
" for lightline
set laststatus=2
set noshowmode
set background=dark
let g:lightline = {'colorscheme': 'catppuccin_mocha'}
" fix ligatures on windows
set renderoptions=type:directx
set encoding=utf-8
" set backspace to 2 (non-linux systems)
set bs=2
" line numbers
set number
" dont create a ton of files
set noswapfile
set nobackup
set nowritebackup
" autodetect filetype
filetype detect
" autoindent
set smartindent
" syntax highlighting
syntax on
" auto cd to files dir
set autochdir
" show existing tab to be 4 spaces width
set tabstop=4
" When pressing tab, write 4 spaces instead, except when using makefiles
" because only tabs are supported with makefiles
if(&ft != 'makefile')
  set expandtab
endif
" Only autoindent by 4 spaces
set shiftwidth=4

" Brace+quotes autocomplete
inoremap ( ()<Esc>i
inoremap { {}<Esc>i
inoremap {<CR> {<CR>}<Esc>O
inoremap [ []<Esc>i
inoremap < <><Esc>i
inoremap ' ''<Esc>i
inoremap " ""<Esc>i

" nicer searching
set hlsearch
nnoremap <F4> :noh<CR>

" setup omnicomplete for autocompletion
filetype plugin on
set omnifunc=syntaxcomplete#Complete
" ... and configure it
set completeopt=menuone,noinsert,noselect

" Now time for some templates!
function Tc()
    :r ~/vimfiles/templates/Tc.c
endfunction

function Tmakefile()
    :r ~/vimfiles/templates/Tmakefile.mk
endfunction

function Tmakefile2()
    :r ~/vimfiles/templates/Tmakefile2.mk
endfunction

function Thtml()
    :r ~/vimfiles/templates/Thtml.html
endfunction

function Tcss()
    :r ~/vimfiles/templates/Tcss.css
endfunction

