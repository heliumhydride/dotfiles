{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    //"type": "small",
    "width": 50,
    "height": 18,
    "padding": {
      "left": 2,
      "top": 1,
      "right": 0
    }
  },
  "display": {
    "separator": "  ",
    "color": "0"
  },
  "modules": [
    "break",
    "break",
    {
      "key": "\uf108 PC",
      "type": "host"
    },
    {
      "format": "{1} x{5} @ {7} GHz",
      "key": "  \uf4bc ",
      "type": "cpu"
    },
    {
      "key": "  \uf4bc ",
      "type": "gpu"
    },
    {
      "key": "  \uefc5 ",
      "type": "memory"
    },
    {
      "key": "  \uefc5 ",
      "type": "swap"
    },
    {
      "format": "{?10}{10} {?}{1} / {2} ({3}) - {9}",
      "key": "  \uf0a0 ",
      "type": "disk"
    },
    {
      "format": "{?1}{1}d {?}{?2}{2}h {?}{3}m",
      "key": "  \uf017 ",
      "type": "uptime"
    },
    "break",
    "break",
    {
      "format": "{2} {12}",
      "key": "\ue712 OS",
      "type": "os"
    },
    {
      "key": "  \ue712 ",
      "type": "kernel"
    },
    {
      "format": "{5}{?8} on {8}",
      "key": "  \uea85 ",
      "type": "terminal"
    },
    {
      "key": "  \uea85 ",
      "type": "shell"
    },
    {
      "format": "{2}",
      "key": "  \ueb7f ",
      "type": "wm"
    },
    {
      "key": "  \udb80\udfd7 ",
      "type": "packages"
    },
  ]
}
